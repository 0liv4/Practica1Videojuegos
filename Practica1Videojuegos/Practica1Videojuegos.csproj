    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="img\beyondtwosouls.jpg" />
    <None Remove="img\cyberpunk-box.jpg" />
    <None Remove="img\eldenring.jpeg" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="img\beyondtwosouls.jpg" />
    <Resource Include="img\cyberpunk-box.jpg" />
    <Resource Include="img\eldenring.jpeg" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="LoginWindow.xaml.cs">
      <Generator></Generator>
    </Compile>
    <Compile Update="MainWindow.xaml.cs">
      <Generator></Generator>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

</Project>