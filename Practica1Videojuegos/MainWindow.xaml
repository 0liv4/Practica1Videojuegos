<Window x:Class="Practica1Videojuegos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica1Videojuegos"
        mc:Ignorable="d"
        Title="Home Videojuegos" Height="450" Width="800"
        Background="#121212">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <Grid Grid.Row="0" Grid.Column="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="5" Margin="8,0">
                    <Label Content="TIENDA" Margin="5,2" FontWeight="Bold" Foreground="White"/>
                </Border>

                <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="5" Margin="8,0">
                    <Label Content="COMUNIDAD" Margin="5,2" FontWeight="Bold" Foreground="White"/>
                </Border>

                <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="5" Margin="8,0">
                    <Label Content="SOPORTE" Margin="5,2" FontWeight="Bold" Foreground="White"/>
                </Border>

            </StackPanel>

            <Label Content="Mi perfil" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="#AAAAAA"/>
        </Grid>

        
        <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Margin="10">
           
            <StackPanel Margin="10,20,10,10" VerticalAlignment="Top">

                <Border BorderBrush="#FF4655" BorderThickness="1.5" CornerRadius="5" Margin="0,8">
                    <Label Content="Destacados" HorizontalAlignment="Center" Margin="0,2" Foreground="White" FontWeight="Bold"/>
                </Border>

                <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="5" Margin="0,8">
                    <Label Content="Mis juegos" HorizontalAlignment="Center" Margin="0,2" Foreground="#AAAAAA"/>
                </Border>

                <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="5" Margin="0,8">
                    <Label Content="Config." HorizontalAlignment="Center" Margin="0,2" Foreground="#AAAAAA"/>
                </Border>

            </StackPanel>
        </Border>

       
        <Border Grid.Row="1" Grid.Column="1" Background="#1E1E1E" CornerRadius="10" Margin="10,10,20,20">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                
                <Label Grid.Row="0" Content="Juegos Destacados" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    
                    <StackPanel Margin="20,0" VerticalAlignment="Top">
                        <Border BorderBrush="#FF4655" BorderThickness="2" CornerRadius="8" Width="130" Height="180">
                            <Border.Background>
                                <ImageBrush ImageSource="/img/beyondtwosouls.jpg" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        
                        <TextBlock Text="Beyond: Two Souls" Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap" Width="130" Margin="0,10,0,0" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>

                    
                    <StackPanel Margin="20,0" VerticalAlignment="Top">
                        <Border BorderBrush="#FF4655" BorderThickness="2" CornerRadius="8" Width="130" Height="180">
                            <Border.Background>
                                <ImageBrush ImageSource="/img/cyberpunk-box.jpg" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="Cyberpunk 2077" Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap" Width="130" Margin="0,10,0,0" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>

                    
                    <StackPanel Margin="20,0" VerticalAlignment="Top">
                        <Border BorderBrush="#FF4655" BorderThickness="2" CornerRadius="8" Width="130" Height="180">
                            <Border.Background>
                                <ImageBrush ImageSource="/img/eldenring.jpeg" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="Elden Ring" Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap" Width="130" Margin="0,10,0,0" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>